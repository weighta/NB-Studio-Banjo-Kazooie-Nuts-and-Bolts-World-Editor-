<Window x:Class="NB.Multiplayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NB Multiplayer" Width="1180" Height="780" MinWidth="980" MinHeight="660"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== sidebar -->
        <Border Background="{StaticResource Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,26,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/nut_accent.png" Width="40" Height="40"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NB Multiplayer" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionText" Text="v1.0.0" Style="{StaticResource SubText}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Banjo-Kazooie: Nuts &amp; Bolts online" Style="{StaticResource SubText}" FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,0,16,20" Padding="14" CornerRadius="10" Background="#1A1B22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GameDot" Width="10" Height="10" Fill="{StaticResource Sub}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="GameStatus" Text="Game not running" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse x:Name="RoomDot" Width="10" Height="10" Fill="{StaticResource Sub}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RoomStatus" Text="Not in a room" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavPlay" Style="{StaticResource Nav}" Content="Play" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavEditions" Style="{StaticResource Nav}" Content="Mods &amp; editions" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavProjects" Style="{StaticResource Nav}" Content="Projects" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="Settings" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Content="About &amp; updates" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================== content -->
        <DockPanel Grid.Column="1">
            <!-- update banner -->
            <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#2E2412" BorderBrush="{StaticResource Accent}"
                    BorderThickness="0,0,0,1" Padding="28,12" ClipToBounds="True">
                <Border.RenderTransform><TranslateTransform x:Name="UpdateBannerSlide"/></Border.RenderTransform>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="UpdateNowButton" Style="{StaticResource Primary}" Content="Update now" Padding="16,7" FontSize="13" Click="UpdateNow_Click"/>
                        <Button Content="What's new" Margin="8,0,0,0" Padding="14,7" FontSize="13" Click="WhatsNew_Click"/>
                        <Button Content="Later" Margin="8,0,0,0" Padding="14,7" FontSize="13" Click="UpdateLater_Click"/>
                        <Button x:Name="UpdateSkipButton" Content="Skip this version" Margin="8,0,0,0" Padding="14,7" FontSize="13" Click="UpdateSkip_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateText" Text="A new version is available." FontWeight="SemiBold"/>
                        <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Margin="0,6,24,0" Maximum="1"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <!-- ======================================================== PLAY -->
                <ScrollViewer x:Name="PagePlay">
                    <StackPanel Margin="36,30,36,36">
                        <TextBlock Text="Play together" Style="{StaticResource H1}"/>
                        <TextBlock Text="Host a room for your friends, or join theirs with a room code. Then play Xbox LIVE matches, or Showdown Town together with the co-op edition."
                                   Style="{StaticResource SubText}" FontSize="14" Margin="0,6,0,22"/>

                        <!-- setup needed -->
                        <Border x:Name="SetupCard" Style="{StaticResource CardBorder}" Margin="0,0,0,18" BorderBrush="{StaticResource Warn}" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Open settings" VerticalAlignment="Center" Click="GoSettings_Click"/>
                                <StackPanel>
                                    <TextBlock Text="First things first" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="SetupText" Style="{StaticResource SubText}" Margin="0,4,16,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- edition -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="22,16">
                            <DockPanel>
                                <TextBlock Text="Edition" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" Width="90"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Link}" Content="Mods &amp; editions" VerticalAlignment="Center" Click="GoEditions_Click" Margin="0,0,16,0"/>
                                    <Button x:Name="SoloButton" Content="Play solo" Padding="14,7" FontSize="13" Click="Solo_Click"
                                            ToolTip="Play this edition on your own: single player, no room"/>
                                </StackPanel>
                                <StackPanel>
                                    <ItemsControl x:Name="EditionChips">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock x:Name="EditionSub" Style="{StaticResource SubText}" Margin="2,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- character select (filled in code: depends on the edition) -->
                        <Border x:Name="CharacterCard" Style="{StaticResource CardBorder}" Margin="0,0,0,18" Padding="22,14">
                            <StackPanel x:Name="CharacterPanel"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- host -->
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel>
                                        <Image Source="Assets/banjo_accent.png" Height="44" DockPanel.Dock="Left" Margin="0,0,14,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Host a room" Style="{StaticResource H2}"/>
                                            <TextBlock Text="Your PC runs the room; friends connect to it." Style="{StaticResource SubText}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <StackPanel x:Name="HostSetup" Margin="0,18,0,0">
                                        <TextBlock Text="Where are your friends?" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <RadioButton x:Name="SteamOption" Style="{StaticResource Option}" GroupName="addr">
                                            <StackPanel>
                                                <TextBlock Text="Anywhere, through Steam (recommended)"/>
                                                <TextBlock Style="{StaticResource SubText}" FontSize="12"
                                                           Text="No port forwarding. Everyone needs Steam running and logged in."/>
                                            </StackPanel>
                                        </RadioButton>
                                        <StackPanel x:Name="AddressOptions"/>
                                        <RadioButton x:Name="PublicOption" Style="{StaticResource Option}" GroupName="addr">
                                            <StackPanel>
                                                <TextBlock Text="Over the internet"/>
                                                <TextBlock Style="{StaticResource SubText}" FontSize="12"
                                                           Text="Forward TCP 36000 and UDP 36001 in your router to this PC."/>
                                            </StackPanel>
                                        </RadioButton>
                                        <DockPanel x:Name="PublicRow" Margin="22,6,0,0">
                                            <Button DockPanel.Dock="Right" Content="Find my address" Margin="8,0,0,0" Padding="12,7" FontSize="13" Click="FindPublicIp_Click"/>
                                            <TextBox x:Name="PublicIpBox" ToolTip="Your public IPv4 address"/>
                                        </DockPanel>
                                        <Button x:Name="HostButton" Style="{StaticResource Primary}" Content="Start hosting" HorizontalAlignment="Left" Margin="0,18,0,0" Click="Host_Click"/>
                                    </StackPanel>

                                    <StackPanel x:Name="HostRunning" Margin="0,18,0,0" Visibility="Collapsed">
                                        <TextBlock Text="ROOM CODE" Style="{StaticResource SubText}" FontSize="11" FontWeight="Bold"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <Button DockPanel.Dock="Right" Content="Copy" Padding="14,7" FontSize="13" VerticalAlignment="Center" Click="CopyCode_Click"/>
                                            <TextBlock x:Name="RoomCodeText" Text="NB-XXXX-XXXX-XXXXX" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock x:Name="HostAddressText" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                                        <Border CornerRadius="8" Background="#1A1B22" Padding="12" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="ReachText" FontSize="13"/>
                                                <Button x:Name="InternetTestButton" Style="{StaticResource Link}" Content="Test from the internet (asks canyouseeme.org)"
                                                        Margin="0,6,0,0" HorizontalAlignment="Left" Click="InternetTest_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button x:Name="HostLaunchButton" Style="{StaticResource Primary}" Content="Launch the game" Click="HostLaunch_Click"/>
                                            <Button Content="Close room" Margin="10,0,0,0" Click="StopHost_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- join -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel>
                                        <Image Source="Assets/trolley_accent.png" Height="44" DockPanel.Dock="Left" Margin="0,0,14,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Join a room" Style="{StaticResource H2}"/>
                                            <TextBlock Text="Paste the room code your friend sent you." Style="{StaticResource SubText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="Room code or address" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                    <TextBox x:Name="JoinBox" FontFamily="Consolas" FontSize="17" KeyDown="JoinBox_KeyDown"/>
                                    <TextBlock Style="{StaticResource SubText}" FontSize="12" Margin="2,4,0,0" Text="e.g. NB-C1A7-YP26-A13D4W, or 203.0.113.5:36000"/>
                                    <Button x:Name="JoinButton" Style="{StaticResource Primary}" Content="Join" HorizontalAlignment="Left" Margin="0,16,0,0" Click="Join_Click"/>
                                    <Border x:Name="JoinResult" CornerRadius="8" Background="#1A1B22" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="JoinResultText" FontSize="13"/>
                                            <Button x:Name="JoinAnywayButton" Content="Play anyway" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="14,7" FontSize="13"
                                                    Visibility="Collapsed" Click="JoinAnyway_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <ProgressBar x:Name="JoinProgress" IsIndeterminate="True" Margin="0,12,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- room members -->
                        <Border x:Name="RoomCard" Style="{StaticResource CardBorder}" Margin="0,18,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="RoomTitle" Text="In the room" Style="{StaticResource H2}"/>
                                <ItemsControl x:Name="RoomPlayers" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- how to -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0" Background="#1D1F27">
                            <StackPanel>
                                <TextBlock Text="In the game" Style="{StaticResource H2}" FontSize="16"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" FontSize="13.5" LineHeight="21">
                                    1. Open MULTIPLAYER, then Xbox LIVE. (A new profile asks to start a new save: choose Yes.)<LineBreak/>
                                    2. Host: set MATCH CHOICE to "Play a game with my party". Friends who join appear in MY PARTY by themselves.<LineBreak/>
                                    3. Host: choose a race or sport under CHOSEN GAME, then START. Don't press B on the party screen (it leaves the party).
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== MODS & EDITIONS -->
                <DockPanel x:Name="PageEditions" Visibility="Collapsed">
                    <!-- build bar: what the ticked mods become -->
                    <Border x:Name="BuildBar" DockPanel.Dock="Bottom" Background="#1D1F27" BorderBrush="{StaticResource Accent}" BorderThickness="0,1,0,0"
                            Padding="36,14,36,16" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="CancelEditButton" Content="Cancel" Padding="14,7" FontSize="13" Margin="0,0,10,0" Click="CancelEdit_Click"/>
                                    <Button x:Name="CombineButton" Style="{StaticResource Primary}" Content="Build an edition" Click="Combine_Click"/>
                                </StackPanel>
                                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left" FontSize="13"/>
                                <TextBox x:Name="CombineName" Margin="0,0,14,0" ToolTip="Name of the edition (optional)"/>
                            </DockPanel>
                            <TextBlock x:Name="BuildMods" Style="{StaticResource SubText}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CombineProblems" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="EditionsScroll">
                        <StackPanel Margin="36,30,36,36">
                            <TextBlock Text="Mods &amp; editions" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource SubText}" FontSize="14" Margin="0,6,0,18" TextWrapping="Wrap"
                                       Text="Mods change the game: new maps, vehicle parts, gameplay, looks and tweaks. Tick the mods you want and build an edition from them, then play it alone or host it. Everyone in a room plays the host's edition; friends get missing mods from the host automatically. Your own game folder is never changed."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Style="{StaticResource Primary}" Content="Add a mod (.nbpatch)" Click="AddEdition_Click"/>
                                <Button Style="{StaticResource BaseButton}" Content="Add a modded game folder" Margin="12,0,0,0" Click="AddModdedFolder_Click"
                                        ToolTip="Turn a game folder you modded by hand (replaced files, edited default.xex) into a mod"/>
                                <Button Style="{StaticResource Link}" Content="Make your own mods in NB Studio" Margin="18,0,0,0" VerticalAlignment="Center" Click="GoProjects_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="EditionBusy" Visibility="Collapsed" Margin="0,0,0,14">
                                <TextBlock x:Name="EditionBusyText" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="EditionBusyBar" Maximum="1" Margin="0,6,0,0"/>
                            </StackPanel>

                            <TextBlock Text="Editions" Style="{StaticResource H2}" Margin="0,4,0,12"/>
                            <StackPanel x:Name="EditionList"/>

                            <Border x:Name="CoopCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" BorderBrush="{StaticResource Accent}">
                                <DockPanel>
                                    <Image Source="Assets/mumbo_accent.png" Height="64" DockPanel.Dock="Left" Margin="0,0,18,0"/>
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button x:Name="CoopAddButton" Style="{StaticResource Primary}" Content="Add co-op edition" Click="AddCoop_Click"
                                                ToolTip="Showdown Town Co-op with every vehicle part unlocked"/>
                                        <Button x:Name="CoopUltraButton" Content="Add co-op + ULTRA Parts" Margin="0,8,0,0" Padding="14,7" FontSize="13" Click="AddCoopUltra_Click"
                                                ToolTip="The same, plus the seven ULTRA parts in Mumbo's Motors"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Showdown Town co-op (preview)" Style="{StaticResource H2}"/>
                                        <TextBlock Style="{StaticResource SubText}" Margin="0,4,16,0" TextWrapping="Wrap"
                                                   Text="Play the single-player game together. Everyone plays their own save; NB Multiplayer drives the other players' vehicles through your Showdown Town (Banjo in a trolley), and you can bump into each other. Town vehicles break apart, and you can change or build vehicles anywhere in town."/>
                                        <TextBlock Style="{StaticResource SubText}" Margin="0,6,16,0" FontSize="12" TextWrapping="Wrap"
                                                   Text="Every vehicle part is unlocked in the co-op edition, whatever your save has. Preview: players on foot, their own vehicle designs, damage between players, shared crates and Acts are not synced yet."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="Mods" Style="{StaticResource H2}" Margin="0,20,0,4"/>
                            <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Text="Your mod library: mods you added, got from a host or made in NB Studio, plus the built-in tweaks. Tick mods to build an edition from them. (For now mods can be combined when they change different game files; tweaks always combine.)"/>
                            <ItemsControl x:Name="ModFilters" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel x:Name="ModList"/>

                            <TextBlock Text="Coming next" Style="{StaticResource H2}" Margin="0,24,0,10"/>
                            <Border Style="{StaticResource CardBorder}" Opacity="0.75">
                                <StackPanel>
                                    <TextBlock Text="Mod depot" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Browse and download community mods straight from GitHub, and share your own from NB Studio."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- ======================================================== PROJECTS -->
                <ScrollViewer x:Name="PageProjects" Visibility="Collapsed">
                    <StackPanel Margin="36,30,36,36">
                        <TextBlock Text="Projects" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource SubText}" FontSize="14" Margin="0,6,0,22" TextWrapping="Wrap"
                                   Text="Your NB Studio projects. NB Studio is the editor that makes mods: worlds, AI vehicles, vehicle parts, scripts and textures. Open a project, try it out, and turn it into a mod for your library and your friends."/>
                        <Border x:Name="StudioCard" Style="{StaticResource CardBorder}" BorderBrush="{StaticResource Accent}">
                            <DockPanel>
                                <Image Source="Assets/nut_gray.png" Height="56" DockPanel.Dock="Left" Margin="0,0,18,0" VerticalAlignment="Top"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StudioGetButton" Content="Get NB Studio" Padding="14,7" FontSize="13" Margin="0,0,10,0" Click="StudioGet_Click"/>
                                    <Button x:Name="StudioOpenButton" Style="{StaticResource Primary}" Content="Open NB Studio" Click="StudioOpen_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="NB Studio" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="StudioStatus" Style="{StaticResource SubText}" Margin="0,4,16,0" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="StudioProgress" Maximum="1" Margin="0,8,16,0" Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource Link}" Content="Use my own copy of NB Studio" Click="StudioBrowse_Click"/>
                                        <Button Style="{StaticResource Link}" Content="NB Studio on GitHub" Margin="18,0,0,0" Click="StudioReleases_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,24,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Add an existing project" Padding="14,7" FontSize="13" Margin="0,0,10,0" Click="ProjectAdd_Click"/>
                                <Button x:Name="ProjectNewButton" Style="{StaticResource Primary}" Content="New project" Click="ProjectNew_Click"/>
                            </StackPanel>
                            <TextBlock Text="Your projects" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border x:Name="NewProjectCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="New project" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NewProjectHelp" Style="{StaticResource SubText}" FontSize="12.5" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Folder..." Padding="12,7" FontSize="13" Margin="10,0,0,0" Click="ProjectFolder_Click"/>
                                        <Button Content="Cancel" Padding="12,7" FontSize="13" Margin="10,0,0,0" Click="ProjectNewCancel_Click"/>
                                        <Button Style="{StaticResource Primary}" Content="Create" Margin="10,0,0,0" Click="ProjectCreate_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="NewProjectName"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="ProjectBusy" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock x:Name="ProjectBusyText" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ProjectBusyBar" Maximum="1" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="ProjectList"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== SETTINGS -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed">
                    <StackPanel Margin="36,30,36,36" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Player name" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource SubText}" Text="Letters and digits, up to 15 characters. Used for your profile the first time the game starts." Margin="0,2,0,8"/>
                                <TextBox x:Name="NameBox" Width="320" HorizontalAlignment="Left" LostFocus="NameBox_LostFocus"/>
                                <TextBlock x:Name="NameError" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,4,0,0"/>

                                <TextBlock Text="Game folder" FontWeight="SemiBold" Margin="0,20,0,0"/>
                                <TextBlock Style="{StaticResource SubText}" Text="Your own copy of Banjo-Kazooie: Nuts &amp; Bolts, extracted: the folder with default.xex and the Bundle folder." Margin="0,2,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0" Click="BrowseGame_Click"/>
                                    <TextBox x:Name="GameDirBox" IsReadOnly="True"/>
                                </DockPanel>
                                <TextBlock x:Name="GameDirError" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SaveCard" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Save game" Style="{StaticResource H2}" FontSize="16"/>
                                <CheckBox x:Name="AllUnlockedCheck" Margin="0,10,0,0" Checked="AllUnlocked_Changed" Unchecked="AllUnlocked_Changed"
                                          Content="Start every game with the all-unlocked save"/>
                                <TextBlock Style="{StaticResource SubText}" FontSize="12.5" Margin="24,4,0,0" TextWrapping="Wrap"
                                           Text="No intro: SINGLE PLAYER > RESUME SAVED GAME takes you straight to Showdown Town with every world, Act, vehicle and part unlocked. The save is put back before each game, so progress made while it is on is not kept. Your own save is set aside and comes back when you turn this off."/>
                                <TextBlock x:Name="SaveStatus" Style="{StaticResource SubText}" FontSize="12.5" Margin="24,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Disk space" Style="{StaticResource H2}" FontSize="16"/>
                                <TextBlock x:Name="StorageText" Style="{StaticResource SubText}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CompactButton" Content="Free up space" Click="Compact_Click" Visibility="Collapsed"/>
                                    <Button Content="Check" Margin="10,0,0,0" Click="StorageCheck_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox x:Name="UpdatesCheck" Content="Check GitHub for new versions when NB Multiplayer starts" Checked="UpdatesCheck_Changed" Unchecked="UpdatesCheck_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Create desktop shortcut" Click="Shortcut_Click"/>
                                    <Button Content="Open data folder" Margin="10,0,0,0" Click="OpenData_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Controllers" Style="{StaticResource H2}" FontSize="16"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" FontSize="13.5" LineHeight="21">
                                    Xbox controllers work as they are.<LineBreak/>
                                    PlayStation 4/5 controllers work directly too (USB or Bluetooth). If you use DS4Windows or Steam's PlayStation support,
                                    the pad can appear twice: close them, or turn on "Hide DS4 Controller" in DS4Windows.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== ABOUT -->
                <ScrollViewer x:Name="PageAbout" Visibility="Collapsed">
                    <StackPanel Margin="36,30,36,36" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="About &amp; updates" Style="{StaticResource H1}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="AboutVersion" Text="NB Multiplayer" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="UpdateStatus" Style="{StaticResource SubText}" Margin="0,6,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource Primary}" Content="Check for updates" Click="CheckUpdates_Click"/>
                                    <Button Content="Releases on GitHub" Margin="10,0,0,0" Click="OpenReleases_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="What it does" Style="{StaticResource H2}" FontSize="16"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" FontSize="13.5" LineHeight="21" TextWrapping="Wrap">
                                    Your hub for playing and modding Nuts &amp; Bolts with friends:<LineBreak/>
                                    - Online play: the game's own Xbox LIVE parties, races and sports, through Steam (no port forwarding).<LineBreak/>
                                    - Showdown Town co-op: play single player together, see each other in town, build and change vehicles at
                                    the same time, and fight (weapon hits break parts off the other player's vehicle).<LineBreak/>
                                    - Mods &amp; editions: a mod library with categories and tick-box tweaks; editions combine mods, and friends
                                    get missing mods from the host when they join.<LineBreak/>
                                    - Projects: your NB Studio projects; NB Studio is installed and updated for you.<LineBreak/>
                                    - The all-unlocked save, Play solo, and automatic updates from GitHub.
                                </TextBlock>
                                <TextBlock Text="How it works" Style="{StaticResource H2}" FontSize="16" Margin="0,16,0,0"/>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,6,0,0" FontSize="13.5" LineHeight="21" TextWrapping="Wrap">
                                    The game runs in an NB build of the Xenia emulator (Xenia Canary netplay by AdrianCassar, with NB networking
                                    changes). For online matches the host's NB Multiplayer is the Xbox LIVE server and relay; for co-op it syncs the
                                    players' vehicles between their games. Nothing is sent to Microsoft or to any public server. Room codes encode the
                                    host's address (or Steam ID) and a fingerprint of the host's game files.
                                </TextBlock>
                                <TextBlock Style="{StaticResource SubText}" Margin="0,10,0,0" FontSize="12.5"
                                           Text="Xenia is licensed under the BSD license (xenia\LICENSE-xenia.txt). Banjo-Kazooie: Nuts &amp; Bolts is a trademark of Microsoft; you need your own copy of the game. Fan project, not affiliated with Rare or Microsoft."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>

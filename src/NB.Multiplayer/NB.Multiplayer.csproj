<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NB.Core\NB.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NBMultiplayer</AssemblyName>
    <RootNamespace>NB.Multiplayer</RootNamespace>
    <Product>NB Multiplayer</Product>
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\app.ico" />
    <!-- the Showdown Town co-op edition (built by coop/build.sh), offered on the Editions page -->
    <None Include="..\..\..\coop\dist\ShowdownTownCoop.nbpatch" Link="patches\ShowdownTownCoop.nbpatch" Condition="Exists('..\..\..\coop\dist\ShowdownTownCoop.nbpatch')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\..\ultra\dist\UltraParts.nbpatch" Link="patches\UltraParts.nbpatch" Condition="Exists('..\..\..\ultra\dist\UltraParts.nbpatch')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- Valve's redistributable Steam API (Steamworks SDK), next to the exe -->
    <None Include="$(NuGetPackageRoot)facepunch.steamworks\2.3.3\content\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NB.Core\NB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NBModStudio</AssemblyName>
    <Version>1.16.0</Version>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationIcon>Assets\studio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Backgrounds\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- the all-unlocked save of NB Multiplayer (coop\saves, beside NBModTool in the project folder or at the top of a checkout):
         Test in Xenia's "full save" (TestSaves.cs); not bundled when it is missing (NB Multiplayer's own copy is used then) -->
    <SavesRoot>$(MSBuildThisFileDirectory)..\..\..\</SavesRoot>
    <SavesRoot Condition="!Exists('$(SavesRoot)coop\saves')">$(MSBuildThisFileDirectory)..\..\</SavesRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(SavesRoot)coop\saves\AllUnlocked.sav" Link="saves\AllUnlocked.sav" Condition="Exists('$(SavesRoot)coop\saves\AllUnlocked.sav')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(SavesRoot)coop\saves\savegame.header.template" Link="saves\savegame.header.template" Condition="Exists('$(SavesRoot)coop\saves\savegame.header.template')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- vgmstream r2117 (ISC license, thirdparty/vgmstream/COPYING; its FFmpeg DLLs are LGPL): decodes the game's XMA2 audio for the Audio tab -->
    <None Include="thirdparty/vgmstream/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
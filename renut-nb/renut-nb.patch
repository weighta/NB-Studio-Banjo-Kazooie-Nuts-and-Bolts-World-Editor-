+// NB: see ReadBackResolve.
+void NoteResolveForReadback(u32 dest_texture) {
+  const u32 dword1 = LoadU32(dest_texture + 0x20);
+  if ((dword1 & 0x3F) != u32(GpuTextureFormat::Fmt8_8_8_8))
+    return;
+  std::lock_guard lock(g_readback_mutex);
+  g_readback_pages.insert(dword1 & ~0xFFFu);

+// NB: resolve destinations the CPU reads. The host renderer keeps what a Resolve writes on the GPU, so guest memory
+// under a resolve destination holds no picture. N&B's Take Photo (0x82535F20) resolves the back buffer into a
+// temporary 8_8_8_8 texture, locks it (D3D::LockSurface) and untiles it on the CPU into the photo it encodes as JPEG
+// and shows as the preview, which came out black. A Resolve notes its destination (NoteResolveForReadback); the next
+// lock of its level 0 reads the host texture back and writes it to guest memory as the GPU would have: components in
+// the destination's order (X and Z exchanged where the guest resolve stores them so), its endian swap and tiling.
+std::mutex g_readback_mutex;
+std::unordered_set<u32> g_readback_pages;  // base pages of 8_8_8_8 destinations resolved since their last lock
+
+bool TakeResolveForReadback(u32 base_page) {
+  std::lock_guard lock(g_readback_mutex);
+  return g_readback_pages.erase(base_page) != 0;
+}
+
+void ReadBackResolve(u32 texture, u32 address, u32 row_pitch) {
+  std::vector<uint8_t> rgba;
+  uint32_t width = 0, height = 0;
+  bool swap_red_blue = false, ok = false;
+  render_thread::Queue([&] { ok = ReadResolveTextureLocked(texture, rgba, width, height, swap_red_blue); });
+  render_thread::Drain();
+  const auto *header = GuestPtr<const d3d::BaseTexture>(texture);
+  u8 *base = GuestPtr<u8>(address);
+  if (!ok || !header || !base)
+    return;
+  const TextureFetch fetch = TextureFetch::FromHeader(header->Format);
+  const TextureLevelLayout layout = GetTextureLevelLayout(fetch, 0);
+  const bool tiled = fetch.Tiled();
+  const u32 endian = fetch.Endian();
+  for (uint32_t y = 0; y < height; ++y) {
+    for (uint32_t x = 0; x < width; ++x) {
+      const uint8_t *t = &rgba[(size_t(y) * width + x) * 4];
+      uint8_t texel[4] = {t[0], t[1], t[2], t[3]};
+      if (swap_red_blue)
+        std::swap(texel[0], texel[2]);
+      SwapEndian(endian, texel, texel, 4);
+      const size_t offset = tiled ? TiledOffset2D(x, y, layout.pitch_texels, 2)
+                                  : size_t(y) * row_pitch + size_t(x) * 4;
+      std::memcpy(base + offset, texel, 4);
+    }
+  }
+  static std::atomic<uint32_t> count{0};
+  const uint32_t n = count.fetch_add(1) + 1;
+  if (n <= 4 || n % 256 == 0)
+    RGPU_INFO("NB: resolve destination {:08X} ({}x{}) read back for the CPU ({} so far)", texture, width, height, n);
+}

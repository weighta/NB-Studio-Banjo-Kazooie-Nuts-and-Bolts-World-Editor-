+// NB: a resolve destination's level 0 read back from the GPU as 8-bit RGBA texels of its guest size (see textures.h).
+namespace {
+
+float HalfToFloat(uint16_t h) {
+  const uint32_t sign = uint32_t(h >> 15) << 31, exp = (h >> 10) & 0x1F, mant = h & 0x3FF;
+  uint32_t bits;
+  if (exp == 0)
+    return std::ldexp(float(mant), -24) * (sign ? -1.0f : 1.0f);
+  if (exp == 31)
+    bits = sign | 0x7F800000u | (mant << 13);
+  else
+    bits = sign | ((exp + 112) << 23) | (mant << 13);
+  return std::bit_cast<float>(bits);
+}
+
+uint8_t UnitToByte(float v) {
+  if (!(v > 0.0f))
+    return 0;
+  if (v >= 1.0f)
+    return 255;
+  return uint8_t(v * 255.0f + 0.5f);
+}
+
+// One host texel at 'p' as R, G, B, A bytes; false for a format this does not read.
+bool HostTexelRgba(plume::RenderFormat format, const uint8_t *p, uint8_t out[4]) {
+  using F = plume::RenderFormat;
+  switch (format) {
+  case F::R8G8B8A8_UNORM:
+    std::memcpy(out, p, 4);
+    return true;
+  case F::B8G8R8A8_UNORM:
+    out[0] = p[2]; out[1] = p[1]; out[2] = p[0]; out[3] = p[3];
+    return true;
+  case F::R16G16B16A16_UNORM:
+    for (int c = 0; c < 4; ++c) {
+      uint16_t v;
+      std::memcpy(&v, p + c * 2, 2);
+      out[c] = uint8_t((uint32_t(v) * 255u + 32767u) / 65535u);
+    }
+    return true;
+  case F::R16G16B16A16_FLOAT:
+    for (int c = 0; c < 4; ++c) {
+      uint16_t v;
+      std::memcpy(&v, p + c * 2, 2);
+      out[c] = UnitToByte(HalfToFloat(v));
+    }
+    return true;
+  default:
+    return false;
+  }
+}
+
+uint32_t HostTexelBytes(plume::RenderFormat format) {
+  using F = plume::RenderFormat;
+  return format == F::R16G16B16A16_UNORM || format == F::R16G16B16A16_FLOAT ? 8 : 4;
+}
+
+} // namespace
+
+bool ReadResolveTextureLocked(u32 texture_va, std::vector<uint8_t> &rgba, uint32_t &width,
+                              uint32_t &height, bool &swap_red_blue) {
+  HostTexture *t = FindHostTextureLocked(texture_va);
+  if (!t || !t->gpu_written || !t->render_target || !t->texture || t->words ||
+      t->dimension != TextureDimension::Tex2D || t->stacked || t->depth != 1)
+    return false;
+  uint8_t probe[4];
+  const uint8_t zero[8] = {};
+  if (!HostTexelRgba(t->host_format, zero, probe))
+    return false;
+  auto &s = State();
+  if (!Video::EnsureCommandListLocked())
+    return false;
+  const uint32_t scale = std::max(1u, t->scale);
+  const uint32_t host_w = t->width * scale, host_h = t->height * scale;
+  const uint32_t texel_bytes = HostTexelBytes(t->host_format);
+  const uint32_t row_texels = (host_w + 63u) & ~63u;  // row pitch: a multiple of 256 bytes
+  const uint64_t row_pitch = uint64_t(row_texels) * texel_bytes;
+  const uint64_t size = row_pitch * host_h;
+  std::unique_ptr<plume::RenderBuffer> buffer =
+      Video::Device()->createBuffer(plume::RenderBufferDesc::ReadbackBuffer(size));
+  if (!buffer)
+    return false;
+  plume::RenderCommandList *cmd = s.command_list;
+  TransitionTextureLocked(t, plume::RenderTextureLayout::COPY_SOURCE);
+  plume::RenderTextureCopyLocation dst = plume::RenderTextureCopyLocation::PlacedFootprint(
+      buffer.get(), t->host_format, host_w, host_h, 1, row_texels);
+  // plume's D3D12 copyTextureRegion reads the destination's texture for its sample positions
+  // even for a buffer footprint: give it the source (single-sampled, no custom positions).
+  dst.texture = t->texture.get();
+  cmd->copyTextureRegion(dst, plume::RenderTextureCopyLocation::Subresource(t->texture.get()));
+  TransitionTextureLocked(t, plume::RenderTextureLayout::SHADER_READ);
+  detail::SubmitAndWaitLocked(s);
+  const auto *data = static_cast<const uint8_t *>(buffer->map());
+  if (!data)
+    return false;
+  width = t->width;
+  height = t->height;
+  swap_red_blue = t->view_swap_red_blue;
+  rgba.assign(size_t(width) * height * 4, 0);
+  for (uint32_t y = 0; y < height; ++y) {
+    for (uint32_t x = 0; x < width; ++x) {
+      uint32_t sum[4] = {};
+      for (uint32_t sy = 0; sy < scale; ++sy) {
+        const uint8_t *row = data + (uint64_t(y) * scale + sy) * row_pitch;
+        for (uint32_t sx = 0; sx < scale; ++sx) {
+          uint8_t texel[4];
+          HostTexelRgba(t->host_format, row + (uint64_t(x) * scale + sx) * texel_bytes, texel);
+          for (int c = 0; c < 4; ++c)
+            sum[c] += texel[c];
+        }
+      }
+      uint8_t *out = &rgba[(size_t(y) * width + x) * 4];
+      for (int c = 0; c < 4; ++c)
+        out[c] = uint8_t((sum[c] + scale * scale / 2) / (scale * scale));
+    }
+  }
+  buffer->unmap();
+  Video::RetireLocked(std::move(buffer));
+  return true;
+}
+
 } // namespace renut::gpu
